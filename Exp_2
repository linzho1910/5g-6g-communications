clc;
clear;
close all;

Fs = 1000;
t = 0:1/Fs:1-1/Fs;

% Three users
u1 = sin(2*pi*5*t);
u2 = sin(2*pi*10*t);
u3 = sin(2*pi*15*t);

% TDMA slot allocation
L = length(t)/3;
tdma = zeros(size(t));

tdma(1:L)       = u1(1:L);
tdma(L+1:2*L)   = u2(L+1:2*L);
tdma(2*L+1:end) = u3(2*L+1:end);

% Plot
figure;

subplot(4,1,1)
plot(t,u1)
title('User 1')

subplot(4,1,2)
plot(t,u2)
title('User 2')

subplot(4,1,3)
plot(t,u3)
title('User 3')

subplot(4,1,4)
plot(t,tdma)
title('TDMA Slot Allocation')
xlabel('Time (s)')
ylabel('Amplitude')
grid on

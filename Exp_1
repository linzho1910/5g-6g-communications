clc;
clear;
close all;

%% Parameters

Fs = 10000;             % Sampling Frequency
t = 0:1/Fs:0.02;        % Time vector

%% Message Signals

m1 = sin(2*pi*100*t);
m2 = sin(2*pi*200*t);
m3 = sin(2*pi*300*t);

%% Carrier Frequencies

fc1 = 1000;
fc2 = 2000;
fc3 = 3000;

%% Carrier Signals

c1 = cos(2*pi*fc1*t);
c2 = cos(2*pi*fc2*t);
c3 = cos(2*pi*fc3*t);

%% Modulation

s1 = m1 .* c1;
s2 = m2 .* c2;
s3 = m3 .* c3;

%% FDMA Combined Signal

FDMA = s1 + s2 + s3;

%% Plot Message Signals

figure;

subplot(4,1,1)
plot(t,m1)
title('Message Signal 1')
xlabel('Time')
ylabel('Amplitude')

subplot(4,1,2)
plot(t,m2)
title('Message Signal 2')
xlabel('Time')
ylabel('Amplitude')

subplot(4,1,3)
plot(t,m3)
title('Message Signal 3')
xlabel('Time')
ylabel('Amplitude')

subplot(4,1,4)
plot(t,FDMA)
title('Combined FDMA Signal')
xlabel('Time')
ylabel('Amplitude')
